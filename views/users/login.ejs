<% layout("/layouts/boilerplate.ejs") %>
<body>
    <div class="row justify-content-center my-4">
        <div class="col-md-8 col-lg-5">
            <div class="form-card">
            <h4>Login on WanderLust</h4>
            <form action="/login" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input class="form-control" placeholder="Enter the username" type="text" name="username" required>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input class="form-control" placeholder="Enter the password" type="password" name="password" required>
                    <div class="valid-feedback">Looks Good!</div>
                </div>
                <button class="btn btn-color w-100" type="submit">Submit</button>
            </form>
            </div>
        </div>
    </div>
</body>